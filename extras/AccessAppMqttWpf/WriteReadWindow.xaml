<Window x:Class="AccessAppMqttWpf.WriteReadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Write-Read"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Type hex, send write-read, and watch replies." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hex" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8"/>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="120">
                            <TextBlock Text="Handle" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Handle, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Width="160" Margin="12,0,0,0">
                            <TextBlock Text="Timeout (s)" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Margin="18,20,0,0">
                            <CheckBox Content="noResponse" IsChecked="{Binding NoResponse}" Margin="0,0,0,6"/>
                            <CheckBox Content="expectReply" IsChecked="{Binding ExpectReply}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Content="Send" Padding="18,8" Command="{Binding SendCommand}" Margin="0,0,0,10"/>

                    <Button Style="{StaticResource GhostButton}" Content="Connect" Padding="18,8" Command="{Binding ConnectCommand}" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource GhostButton}" Content="Disconnect" Padding="18,8" Command="{Binding DisconnectCommand}" Margin="0,0,0,10"/>

                    <Button Style="{StaticResource GhostButton}" Content="Copy selected line" Padding="18,8" Command="{Binding CopyLineCommand}" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource GhostButton}" Content="Copy hex from reply" Padding="18,8" Command="{Binding CopyHexCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Output -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <TextBlock Text="Replies" FontWeight="SemiBold" DockPanel.Dock="Top"/>
                <ListBox ItemsSource="{Binding Lines}"
                         SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                         Margin="0,10,0,0">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy line" Command="{Binding CopyLineCommand}"/>
                            <MenuItem Header="Copy hex" Command="{Binding CopyHexCommand}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

    </Grid>
</Window>
