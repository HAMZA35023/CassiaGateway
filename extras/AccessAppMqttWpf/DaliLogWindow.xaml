<Window x:Class="AccessAppMqttWpf.DaliLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DALI Logger"
        Height="620" Width="1200"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Signal-type → background colour (semantic, kept regardless of theme) -->
        <Style x:Key="SignalCell" TargetType="TextBlock">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SignalType}" Value="BW">
                    <Setter Property="Background" Value="#5B6D8A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SignalType}" Value="DALI">
                    <Setter Property="Background" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SignalType}" Value="DALI-2">
                    <Setter Property="Background" Value="#1565C0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SignalType}" Value="Info">
                    <Setter Property="Background" Value="#6A1E6A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Toolbar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource Card2Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <!-- Status indicator -->
                <Ellipse x:Name="StatusDot" DockPanel.Dock="Left"
                         Width="10" Height="10" Margin="0,0,6,0"
                         Fill="{DynamicResource BadBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusLabel" DockPanel.Dock="Left"
                           Text="Stopped" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Entry count -->
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Left"
                           Text="0 entries" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Buttons (right-aligned) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AutoScrollBtn" Content="Auto-scroll: ON"
                            Style="{DynamicResource GhostButton}"
                            Padding="8,4" Margin="4,0"
                            Click="AutoScrollBtn_Click"/>
                    <Button x:Name="ClearBtn" Content="Clear"
                            Style="{DynamicResource GhostButton}"
                            Padding="8,4" Margin="4,0"
                            Click="ClearBtn_Click"/>
                    <Button x:Name="CopyBtn" Content="Copy to Clipboard"
                            Style="{DynamicResource GhostButton}"
                            Padding="8,4" Margin="4,0"
                            Click="CopyBtn_Click"/>
                </StackPanel>

                <TextBlock/><!-- spacer -->
            </DockPanel>
        </Border>

        <!-- ── DataGrid ─────────────────────────────────────────────────── -->
        <DataGrid x:Name="Grid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  FontFamily="Consolas"
                  FontSize="12"
                  CanUserResizeRows="False">

            <DataGrid.Columns>
                <!-- Time -->
                <DataGridTextColumn Header="Time" Width="90"
                    Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"/>

                <!-- Signal type (coloured) -->
                <DataGridTemplateColumn Header="Type" Width="62">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SignalType}" Style="{StaticResource SignalCell}"
                                       TextAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Sequence number -->
                <DataGridTextColumn Header="Seq" Width="44"
                    Binding="{Binding Seq}"/>

                <!-- Raw hex -->
                <DataGridTextColumn Header="Raw" Width="62"
                    Binding="{Binding RawHex}"/>

                <!-- Address -->
                <DataGridTextColumn Header="Address" Width="100"
                    Binding="{Binding AddressType}"/>
                <DataGridTextColumn Header="#" Width="34"
                    Binding="{Binding Address}"/>

                <!-- Instance type -->
                <DataGridTextColumn Header="Instance" Width="130"
                    Binding="{Binding InstanceType}"/>

                <!-- Description (main readable text) -->
                <DataGridTextColumn Header="Description" Width="*"
                    Binding="{Binding Description}"/>

                <!-- Value -->
                <DataGridTextColumn Header="Value" Width="72"
                    Binding="{Binding ValueHex}"/>

                <!-- Missing entries warning -->
                <DataGridTextColumn Header="Gap" Width="44"
                    Binding="{Binding MissingEntries}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Status bar ────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{DynamicResource Card2Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock x:Name="FooterLabel" Text="Ready"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
        </Border>
    </Grid>
</Window>
