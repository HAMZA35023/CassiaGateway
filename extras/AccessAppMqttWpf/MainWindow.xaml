<Window x:Class="AccessAppMqttWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AccessAppMqttWpf.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AC Controller for AccessAPP - v0.5.0"
        Height="941" Width="1715"
        WindowStartupLocation="CenterScreen"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase">

    <Window.Resources>

        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
        <SolidColorBrush x:Key="DoneRowBrush" Color="#2A22C55E"/>
        <SolidColorBrush x:Key="QueueRowBrush" Color="#2A60A5FA"/>
        <SolidColorBrush x:Key="WarnRowBrush" Color="#2AF59E0B"/>
        <SolidColorBrush x:Key="FailedRowBrush" Color="#2AE74C3C"/>


        <!-- ONLINE / OFFLINE badge -->
        <DataTemplate x:Key="CassiaStateBadge">
            <Border x:Name="Badge"
                    CornerRadius="10"
                    Padding="10,3"
                    Background="#777">
                <TextBlock x:Name="Txt"
                           Text="UNKNOWN"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="online">
                    <Setter TargetName="Badge" Property="Background" Value="#2ECC71"/>
                    <Setter TargetName="Txt" Property="Text" Value="ONLINE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="offline">
                    <Setter TargetName="Badge" Property="Background" Value="#E74C3C"/>
                    <Setter TargetName="Txt" Property="Text" Value="OFFLINE"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Refresh badge button (same style as ONLINE/OFFLINE badge) -->
        <Style x:Key="CassiaBadgeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#777"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="online">
                    <Setter Property="Background" Value="#2ECC71"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="offline">
                    <Setter Property="Background" Value="#E74C3C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CassiaBadgeButtonStyleWarning" TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#777"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="online">
                    <Setter Property="Background" Value="Orange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="offline">
                    <Setter Property="Background" Value="#E74C3C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Simple tabs styling -->
        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANEL ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ===== Cassia gateways (TOP LEFT) ===== -->
                    <TextBlock Text="Cassia gateways"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <!-- Runtime control of parallel programmers (ALL gateways) -->
                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Parallel programmers (all):" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBox Width="52" Margin="10,0,6,0" Padding="6,3"
                                     Text="{Binding ParallelProgrammersAllDesired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,6,0"
                                    Content="⬆ Set all"
                                    Command="{Binding SetParallelProgrammersForAllCassiasCommand}"/>
                            <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,0,0"
                                    Content="⬇ Get all"
                                    Command="{Binding GetParallelProgrammersForAllCassiasCommand}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding CassiaGateways}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                                                <Border Background="{StaticResource CardBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Margin="0,0,0,8"
        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

    <Border.ContextMenu>
        <!-- ContextMenu is rendered in a Popup (separate visual tree), so it cannot use AncestorType=Window.
             Bind via PlacementTarget instead. -->
        <ContextMenu>
            <MenuItem Header="Set MQTT scope (networkId)..."
                      Command="{Binding PlacementTarget.Tag.SetCassiaMqttScopeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </Border.ContextMenu>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left color stripe -->
        <Border Grid.Column="0" Background="{Binding StripeBrush}" CornerRadius="10,0,0,10"/>

        <!-- Content spacing -->
        <Border Grid.Column="1" Padding="10" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- =========================
                     Row 0: Header
                     ========================= -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding NameWithVersion}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="8,0,0,0">

                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource CassiaStateBadge}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>

                        <Button Style="{StaticResource CassiaBadgeButtonStyleWarning}"
                                Content="🧹"
                                Margin="0,0,6,0"
                                ToolTip="Clear device settings backups"
                                Command="{Binding DataContext.ClearDeviceSettingsBackupsForCassiaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Name}"/>

                        <Button Style="{StaticResource CassiaBadgeButtonStyleWarning}"
                                Content="↻"
                                Margin="0,0,6,0"
                                ToolTip="Refresh firmware manifest"
                                Command="{Binding DataContext.RefreshFwManifestForCassiaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Name}"/>

                        <Button Style="{StaticResource CassiaBadgeButtonStyle}"
                                Content="📈"
                                Margin="0,0,0,0"
                                ToolTip="Open speed graph (up to 12 hours)"
                                Command="{Binding DataContext.OpenSpeedGraphCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Name}"/>
                    </StackPanel>
                </Grid>

                <!-- =========================
                     Row 1: Metrics + Info + SetParallel
                     ========================= -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Metrics + Info -->
                    <StackPanel Grid.Column="0" Orientation="Vertical">

                        <!-- Metrics row (icons) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Queue -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text=" " FontSize="12"/>
                                <TextBlock Text="{Binding Queue}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>

                            <!-- Programming -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="⚙" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text=" " FontSize="12"/>
                                <TextBlock Text="{Binding Programming}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>

                            <!-- Speed -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📶" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text=" " FontSize="12"/>
                                <TextBlock Text="{Binding TotalSpeedpct}" Foreground="Red" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text=" %/min" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,0"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- Info grid -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Last:"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding LastSeenLocal}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Devices:"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,2,10,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding DevicesSeen}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Workers:"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,2,10,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding ParallelProgrammers}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </Grid>

                    </StackPanel>

                    <!-- Right: SetParallel -->
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Set parallel:"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox Width="52" Margin="8,0,0,0" Padding="6,3"
                                     Text="{Binding ParallelProgrammersDesired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource GhostButton}" Padding="12,4" Margin="0,0,6,0"
                                    Content="⬆ Set"
                                    Command="{Binding DataContext.SetParallelProgrammersForCassiaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Style="{StaticResource GhostButton}" Padding="12,4"
                                    Content="⬇ Get"
                                    Command="{Binding DataContext.GetParallelProgrammersForCassiaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Name}"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>

                <!-- =========================
                     Row 2: Assign (ONE LINE)
                     ========================= -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Assign:"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <Run Text="P41 " Foreground="{StaticResource MutedBrush}"/>
                        <Run Text="{Binding AssignedP41}" FontWeight="SemiBold"/>
                        <Run Text="   " />

                        <Run Text="P42 " Foreground="{StaticResource MutedBrush}"/>
                        <Run Text="{Binding AssignedP42}" FontWeight="SemiBold"/>
                        <Run Text="   " />

                        <Run Text="P46 " Foreground="{StaticResource MutedBrush}"/>
                        <Run Text="{Binding AssignedP46}" FontWeight="SemiBold"/>
                        <Run Text="   |   " Foreground="{StaticResource MutedBrush}"/>

                        <Run Text="P47 " Foreground="{StaticResource MutedBrush}"/>
                        <Run Text="{Binding AssignedP47}" FontWeight="SemiBold"/>
                        <Run Text="   " />

                        <Run Text="P48 " Foreground="{StaticResource MutedBrush}"/>
                        <Run Text="{Binding AssignedP48}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ===== Connection ===== -->
                    <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="Host" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttHost}" Visibility="Collapsed"/>

                    <TextBlock Text="Port" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttPort}" Visibility="Collapsed"/>

                    <TextBlock Text="Topic" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttTopic}" Visibility="Collapsed"/>

                    <TextBlock Text="Username" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttUser}" Visibility="Collapsed"/>

                    <TextBlock Text="Password" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" Visibility="Collapsed"/>

                    <CheckBox Content="Use TLS" IsChecked="{Binding UseTls}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <CheckBox Content="Ignore TLS certificate errors" IsChecked="{Binding IgnoreTlsErrors}" Margin="0,4,0,0" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="{Binding ConnectButtonText}"
                                Command="{Binding ToggleConnectCommand}"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="Resync"
                                Command="{Binding ResyncCommand}"
                                Margin="8,0,0,0"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="Save"
                                Command="{Binding SaveSettingsCommand}"
                                Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ===== Scope / Network ===== -->
                    <TextBlock Text="Scope" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="NetworkId" Style="{StaticResource MetaLabel}"/>
                    <TextBox Text="{Binding NetworkId}"/>

                    <TextBlock Text="Command topic template" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding CommandTopicTemplate}" Visibility="Collapsed"/>

                    <TextBlock Text="Default command" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding DefaultCommand}" Visibility="Collapsed"/>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ===== Firmware selection (DROPDOWNS) ===== -->
                    <TextBlock Text="Firmware selection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="P41 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP41}" SelectedItem="{Binding SelectedFirmwareP41}"/>

                    <TextBlock Text="P42 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP42}" SelectedItem="{Binding SelectedFirmwareP42}"/>

                    <TextBlock Text="P46 firmware (also P49)" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP46}" SelectedItem="{Binding SelectedFirmwareP46}"/>

                    <TextBlock Text="P47 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP47}" SelectedItem="{Binding SelectedFirmwareP47}"/>

                    <TextBlock Text="P48 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP48}" SelectedItem="{Binding SelectedFirmwareP48}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= RIGHT PANEL ================= -->
        <DockPanel Grid.Column="2">
            <!-- Throttled UI update cadence indicator -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="UI update cadence" FontWeight="SemiBold" Opacity="0.85"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ProgressUiCountdownText}" Margin="0,0,14,0" Opacity="0.85"/>
                        <TextBlock Text="{Binding DiscoveredUiCountdownText}" Opacity="0.85"/>
                        <Button Style="{StaticResource GhostButton}" Content="Refresh UI" Padding="12,6" Margin="14,0,0,0" Command="{Binding RefreshUiNowCommand}" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Style="{StaticResource TabControlStyle}">


            <!-- ===== Devices ===== -->
            <TabItem Header="Devices">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <!-- TOP controls -->
                            <!-- TOP controls -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ROW 0: Left title + subtitle + status, Right filters/buttons -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left header -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold"/>

                                        <!-- Subtitle (existing) -->
                                        <TextBlock Text="  "/>
                                        <TextBlock Text="{Binding DevicesSubtitle}" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>

                                    <!-- Right top line (unchanged layout, as you said top line is ok) -->
                                    <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                                        <TextBox Width="280"
                     Text="{Binding DeviceFilter, UpdateSourceTrigger=PropertyChanged}"
                     Margin="18,0,10,0"/>

                                        <ComboBox Width="120"
                      ItemsSource="{Binding SensorFilterOptions}"
                      SelectedItem="{Binding SensorFilter}"/>

                                        <Button Style="{StaticResource GhostButton}"
                    Content="Remove out of range"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0"
                    Command="{Binding RemoveRssiMinus127DevicesCommand}"/>

                                        <Button Style="{StaticResource GhostButton}"
                    Content="Clear"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="ClearDevices_Click"/>

                                        <Button Style="{StaticResource GhostButton}"
                    Content="Clear + Reload"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0"
                    Command="{Binding ClearAndReloadDeviceListCommand}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 1: Check all left | checkboxes right-aligned | Reassign right -->
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: bulk selection / actions -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Check all"
                                                Padding="12,6"
                                                VerticalAlignment="Center"
                                                MinWidth="110"
                                                Command="{Binding CheckAllDevicesCommand}"/>

                                        <Button Style="{StaticResource GhostButton}"
                                                Content="Get FW selected"
                                                Padding="12,6"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"
                                                Command="{Binding GetFwSelectedCommand}"/>
                                    </StackPanel>

                                    <!-- Middle: checkboxes (RIGHT aligned, sits next to Reassign) -->
                                    <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,10,0">

                                        <CheckBox x:Name="EnableDoubleClickQueueCheckBox"
                      Content="Double-click to queue"
                      IsChecked="{Binding EnableDoubleClickQueue, Mode=TwoWay}"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"/>

                                        <CheckBox Content="Hide completed"
                      IsChecked="{Binding HideCompletedDevices, Mode=TwoWay}"
                      Margin="14,0,0,0"
                      VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Right: Reassign (fully right) -->
                                    <Button Grid.Column="2"
                Style="{StaticResource PrimaryButton}"
                Content="Reassign"
                Padding="12,6"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                MinWidth="110"
                ToolTip="Re-balance sticky Cassia assignments (will not change again until you press this)."
                Command="{Binding ReassignDevicesCommand}"/>
                                </Grid>
                            </Grid>

                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Discovered devices -->
                            <DataGrid x:Name="DevicesGrid"
                                      Grid.Row="0"
                                      ItemsSource="{Binding FilteredDevices}"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      MouseDoubleClick="DevicesGrid_MouseDoubleClick"
                                      IsReadOnly="False"
                                      CanUserSortColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" ScrollViewer.CanContentScroll="True">

                                <!-- Right-click device actions (Connect / Disconnect / Write-Read) -->
                                <!-- NOTE: ContextMenu is not in the visual tree; we stash the VM on the row Tag to bind commands reliably. -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <EventSetter Event="ContextMenuOpening" Handler="DevicesRow_ContextMenuOpening"/>
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Connect"
                                                              Command="{Binding PlacementTarget.Tag.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Disconnect"
                                                              Command="{Binding PlacementTarget.Tag.DisconnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Assign to Cassia" Tag="AssignCassia"/>
                                                    <Separator/>
                                                    <MenuItem Header="Write-Read…"
                                                              Command="{Binding PlacementTarget.Tag.OpenWriteReadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    

<Style.Triggers>
    <!-- If the latest upgrade-log entry is Warn, mark the row orange. -->
    <DataTrigger Binding="{Binding IsUpgradeWarn}" Value="True">
        <Setter Property="Background" Value="{StaticResource WarnRowBrush}"/>
        <Setter Property="Foreground" Value="Black"/>
    </DataTrigger>

