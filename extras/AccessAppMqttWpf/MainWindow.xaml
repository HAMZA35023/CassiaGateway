<Window x:Class="AccessAppMqttWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AccessAppMqttWpf.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AccessAPP • MQTT Device Queue"
        Height="941" Width="1715"
        WindowStartupLocation="CenterScreen"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase">

    <Window.Resources>

        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
        <SolidColorBrush x:Key="DoneRowBrush" Color="#2A22C55E"/>
        <SolidColorBrush x:Key="QueueRowBrush" Color="#2A60A5FA"/>


        <!-- ONLINE / OFFLINE badge -->
        <DataTemplate x:Key="CassiaStateBadge">
            <Border x:Name="Badge"
                    CornerRadius="10"
                    Padding="8,2"
                    Background="#777">
                <TextBlock x:Name="Txt"
                           Text="UNKNOWN"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="online">
                    <Setter TargetName="Badge" Property="Background" Value="#2ECC71"/>
                    <Setter TargetName="Txt" Property="Text" Value="ONLINE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="offline">
                    <Setter TargetName="Badge" Property="Background" Value="#E74C3C"/>
                    <Setter TargetName="Txt" Property="Text" Value="OFFLINE"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Refresh badge button (same style as ONLINE/OFFLINE badge) -->
        <Style x:Key="CassiaBadgeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#777"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="online">
                    <Setter Property="Background" Value="#2ECC71"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="offline">
                    <Setter Property="Background" Value="#E74C3C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Simple tabs styling -->
        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANEL ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ===== Cassia gateways (TOP LEFT) ===== -->
                    <TextBlock Text="Cassia gateways"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <!-- Runtime control of parallel programmers (ALL gateways) -->
                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Parallel programmers (all):" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBox Width="52" Margin="10,0,6,0" Padding="6,3"
                                     Text="{Binding ParallelProgrammersAllDesired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,6,0"
                                    Content="Set all"
                                    Command="{Binding SetParallelProgrammersForAllCassiasCommand}"/>
                            <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,0,0"
                                    Content="Get all"
                                    Command="{Binding GetParallelProgrammersForAllCassiasCommand}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding CassiaGateways}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <!-- FIX: 2 rows so badge sits in row 0 and text can use full width below -->
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Row 0: Name + badges -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding NameWithVersion}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Top"/>

                                        <StackPanel Grid.Row="0" Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource CassiaStateBadge}"
                                                            VerticalAlignment="Top"/>

                                            <Button Style="{StaticResource CassiaBadgeButtonStyle}"
                                                    Content="↻"
                                                    Margin="6,0,0,0"
                                                    ToolTip="Refresh firmware manifest"
                                                    Command="{Binding DataContext.RefreshFwManifestForCassiaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Name}"/>

                                            <Button Style="{StaticResource CassiaBadgeButtonStyle}"
                                                    Content="📈"
                                                    Margin="6,0,0,0"
                                                    ToolTip="Open speed graph (last 1 hour)"
                                                    Command="{Binding DataContext.OpenSpeedGraphCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Name}"/>

                                        </StackPanel>

                                        <!-- Row 1: all details spans full width so no hidden text -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Orientation="Vertical"
                                                    Margin="0,6,0,0">

                                            
                                            <!-- Line 1 -->
                                            <TextBlock FontSize="12">
                                                <Run Text="Last:" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding LastSeenLocal, Mode=OneWay}" FontWeight="SemiBold" Foreground="Black"/>
                                                <Run Text=""/>

                                                <Run Text="Devices:" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding DevicesSeen}" FontWeight="SemiBold" Foreground="Black"/>
                                                <Run Text=""/>

                                                <Run Text=" | Workers" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding ParallelProgrammers}" FontWeight="SemiBold" Foreground="Black"/>

                                            </TextBlock>

                                            <!-- Line 2 -->
                                            <TextBlock FontSize="12" Margin="0,4,0,0">
                                                <Run Text="Speed:" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding TotalSpeedpct}" FontWeight="SemiBold" Foreground="Black"/>
                                                <Run Text=" "/>
                                                <Run Text="% / min" Foreground="{StaticResource MutedBrush}"/>
                                                
                                                <Run Text="  |  Queue" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Queue}" FontWeight="SemiBold" Foreground="Black"/>
                                                <Run Text=" "/>

                                                <Run Text="Programming" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Programming}" FontWeight="SemiBold" Foreground="Black"/>

                                            </TextBlock>

                                            <!-- Line 2b: runtime control of parallel programmers (per Cassia) -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="Set parallel:" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBox Width="52" Margin="8,0,6,0" Padding="6,3"
                                                         Text="{Binding ParallelProgrammersDesired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,6,0"
                                                        Content="Set"
                                                        Command="{Binding DataContext.SetParallelProgrammersForCassiaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,0,0"
                                                        Content="Get"
                                                        Command="{Binding DataContext.GetParallelProgrammersForCassiaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}"/>
                                            </StackPanel>

                                            <!-- Line 3: Sticky assignment counts -->
                                            <TextBlock FontSize="12" Margin="0,4,0,0">
                                                <Run Text="Assign:" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>

                                                <Run Text="P41" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding AssignedP41}" Foreground="Black" FontWeight="SemiBold"/>
                                                <Run Text="   "/>

                                                <Run Text="P42" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding AssignedP42}" Foreground="Black" FontWeight="SemiBold"/>
                                                <Run Text="   "/>

                                                <Run Text="P46" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding AssignedP46}" Foreground="Black" FontWeight="SemiBold"/>

                                                <Run Text="   |   "/>

                                                <Run Text="P47" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding AssignedP47}" Foreground="Black" FontWeight="SemiBold"/>
                                                <Run Text="   "/>

                                                <Run Text="P48" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding AssignedP48}" Foreground="Black" FontWeight="SemiBold"/>
                                            </TextBlock>


                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ===== Connection ===== -->
                    <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="Host" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttHost}" Visibility="Collapsed"/>

                    <TextBlock Text="Port" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttPort}" Visibility="Collapsed"/>

                    <TextBlock Text="Topic" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttTopic}" Visibility="Collapsed"/>

                    <TextBlock Text="Username" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttUser}" Visibility="Collapsed"/>

                    <TextBlock Text="Password" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" Visibility="Collapsed"/>

                    <CheckBox Content="Use TLS" IsChecked="{Binding UseTls}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <CheckBox Content="Ignore TLS certificate errors" IsChecked="{Binding IgnoreTlsErrors}" Margin="0,4,0,0" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="{Binding ConnectButtonText}"
                                Command="{Binding ToggleConnectCommand}"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="Save"
                                Command="{Binding SaveSettingsCommand}" Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ===== Scope / Network ===== -->
                    <TextBlock Text="Scope" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="NetworkId" Style="{StaticResource MetaLabel}"/>
                    <TextBox Text="{Binding NetworkId}"/>

                    <TextBlock Text="Command topic template" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding CommandTopicTemplate}" Visibility="Collapsed"/>

                    <TextBlock Text="Default command" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding DefaultCommand}" Visibility="Collapsed"/>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ===== Firmware selection (DROPDOWNS) ===== -->
                    <TextBlock Text="Firmware selection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="P41 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP41}" SelectedItem="{Binding SelectedFirmwareP41}"/>

                    <TextBlock Text="P42 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP42}" SelectedItem="{Binding SelectedFirmwareP42}"/>

                    <TextBlock Text="P46 firmware (also P49)" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP46}" SelectedItem="{Binding SelectedFirmwareP46}"/>

                    <TextBlock Text="P47 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP47}" SelectedItem="{Binding SelectedFirmwareP47}"/>

                    <TextBlock Text="P48 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP48}" SelectedItem="{Binding SelectedFirmwareP48}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= RIGHT PANEL ================= -->
        <DockPanel Grid.Column="2">
            <!-- Throttled UI update cadence indicator -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="UI update cadence" FontWeight="SemiBold" Opacity="0.85"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ProgressUiCountdownText}" Margin="0,0,14,0" Opacity="0.85"/>
                        <TextBlock Text="{Binding DiscoveredUiCountdownText}" Opacity="0.85"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Style="{StaticResource TabControlStyle}">


            <!-- ===== Devices ===== -->
            <TabItem Header="Devices">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <!-- TOP controls -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                            <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="  "/>
                            <TextBlock Text="{Binding DevicesSubtitle}" Foreground="{StaticResource MutedBrush}"/>

                                </StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">

                                <TextBox Width="280" Text="{Binding DeviceFilter, UpdateSourceTrigger=PropertyChanged}" Margin="18,0,10,0"/>
                                <ComboBox Width="120" ItemsSource="{Binding SensorFilterOptions}" SelectedItem="{Binding SensorFilter}"/>
                                <CheckBox x:Name="EnableDoubleClickQueueCheckBox"
                                          Content="Double-click to queue"
                                          IsChecked="{Binding EnableDoubleClickQueue, Mode=TwoWay}"
                                          Margin="14,0,10,0"
                                          VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Clear"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Click="ClearDevices_Click"/>

                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Check all"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"
                                        Command="{Binding CheckAllDevicesCommand}"/>

                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Reassign"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"
                                        ToolTip="Re-balance sticky Cassia assignments (will not change again until you press this)."
                                        Command="{Binding ReassignDevicesCommand}"/>
                            
                        

                            </StackPanel>
</DockPanel>

<Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Discovered devices -->
                            <DataGrid x:Name="DevicesGrid"
                                      Grid.Row="0"
                                      ItemsSource="{Binding FilteredDevices}"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      MouseDoubleClick="DevicesGrid_MouseDoubleClick"
                                      IsReadOnly="False"
                                      CanUserSortColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" ScrollViewer.CanContentScroll="True">

                                <!-- Right-click device actions (Connect / Disconnect / Write-Read) -->
                                <!-- NOTE: ContextMenu is not in the visual tree; we stash the VM on the row Tag to bind commands reliably. -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Connect"
                                                              Command="{Binding PlacementTarget.Tag.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Disconnect"
                                                              Command="{Binding PlacementTarget.Tag.DisconnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Write-Read…"
                                                              Command="{Binding PlacementTarget.Tag.OpenWriteReadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    

<Style.Triggers>
    <!-- Completed devices are green, but queue/progress state should override (stay blue while queued) -->
    <DataTrigger Binding="{Binding IsUpgradeSuccess}" Value="True">
        <Setter Property="Background" Value="{StaticResource DoneRowBrush}"/>
        <Setter Property="Foreground" Value="Black"/>
    </DataTrigger>

    <DataTrigger Binding="{Binding IsInQueue}" Value="True">
        <Setter Property="Background" Value="{StaticResource QueueRowBrush}"/>
        <Setter Property="Foreground" Value="Black"/>
    </DataTrigger>
</Style.Triggers>
</Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="32" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Focusable="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Update FW" Width="100" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Update" Padding="10,4" Click="UpdateFw_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInQueue}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductNumber}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Model" Binding="{Binding SensorModel}" Width="50" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="RSSI" Binding="{Binding BestRssi}" Width="50" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Cassia (best)" Binding="{Binding BestCassia}" Width="90" IsReadOnly="True"/>

                                    <!-- Sticky assignment (used for commands) -->
                                    <DataGridTemplateColumn Header="Assigned Cassia" Width="120" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AssignedCassia}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.CassiaNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         SelectedItem="{Binding AssignedCassia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="120">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInQueue}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Status" Binding="{Binding ProcessStatus}" Width="200" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="%" Binding="{Binding ProcessProgress}" Width="40" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="FW" Binding="{Binding ProcessFirmware}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Current FW" Binding="{Binding DisplayFw}" Width="90" IsReadOnly="True"/>

                                    <DataGridTemplateColumn Header="Get FW" Width="90" CanUserSort="False"  Visibility="Collapsed">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}" Content="Get FW" Padding="10,4"
                                                        Click="GetFw_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Proc Cassia" Binding="{Binding ProcessCassia}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Proc Time" Binding="{Binding ProcessLastUpdateLocal}" Width="150" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- ===== MOVED FROM QUEUE TAB TO HERE ===== -->
<!-- Queue list below discovered devices -->
                            <GridSplitter Grid.Row="1"
                                          Height="5"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="{StaticResource BorderBrush}"
                                          ShowsPreview="True"/>

                            <DockPanel Grid.Row="2">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Queued devices" FontWeight="SemiBold"/>
                                    <TextBlock Text="  " />
                                    <TextBlock Text="(same data as Queue tab)" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>

                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Update / Queue selected" Padding="12,6" Margin="0,0,8,0" Command="{Binding QueueSelectedCommand}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Clear queue" Padding="12,6" Margin="0,0,8,0" Command="{Binding ClearQueueCommand}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Default sort" Padding="12,6" Click="QueueDefaultSort_Click"/>
                                    </StackPanel>
                                </DockPanel>


                                <DataGrid x:Name="QueueGridInline"
                                          ItemsSource="{Binding QueueView}"
                                          SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160"/>
                                        <DataGridTextColumn Header="Cassia" Binding="{Binding Cassia}" Width="110"/>
                                        <DataGridTextColumn Header="Model" Binding="{Binding DetectorType}" Width="70"/>
                                        <DataGridTextColumn Header="FW" Binding="{Binding FirmwareVersion}" Width="90"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="260"/>
                                        <DataGridTemplateColumn Header="%" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Progress, StringFormat={}{0}%}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="">
                                                                        <Setter Property="Text" Value=""/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                                        <Setter Property="Text" Value=""/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="queued">
                                                                        <Setter Property="Text" Value=""/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                        <Setter Property="Text" Value=""/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== Queue ===== -->
            <TabItem Header="Queue">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Queue" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>

                        <DataGrid x:Name="QueueGrid"
                                  ItemsSource="{Binding QueueView}"
                                  SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  Sorting="QueueGrid_Sorting" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160"/>
                                <DataGridTextColumn Header="Cassia" Binding="{Binding Cassia}" Width="110"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding DetectorType}" Width="70"/>
                                <DataGridTextColumn Header="FW" Binding="{Binding FirmwareVersion}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                                <DataGridTemplateColumn Header="%" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Progress, StringFormat={}{0}%}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="queued">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== Upgrade log ===== -->
            <TabItem Header="Upgrade log">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="Upgrade log" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="  " />
                            <TextBlock Text="{Binding UpgradeLogSummary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                            <TextBlock Text="   Search:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            <TextBox Width="220"
                                     Text="{Binding UpgradeLogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"/>

                            <!-- UPDATED: add (LogId dropdown) + keep existing gateway dropdown + request/clear buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,0,0">
                                <ComboBox Width="160"
                                          ItemsSource="{Binding LogGatewayOptions}"
                                          SelectedItem="{Binding SelectedLogGatewayName}"
                                          Margin="0,0,8,0"/>

                                <ComboBox Width="260"
                                          ItemsSource="{Binding LogIdOptions}"
                                          SelectedItem="{Binding SelectedLogId}"
                                          Margin="0,0,8,0"/>

                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Request"
                                        Command="{Binding RequestUpgradeLogCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Clear on Cassia"
                                        Command="{Binding ClearUpgradeLogOnCassiaCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Clear"
                                        Command="{Binding ClearUpgradeLogCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding UpgradeLogGroupsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}"
                                                BorderThickness="2"
                                                Padding="10"
                                                Margin="0,0,0,10"
                                                CornerRadius="10"
                                                BorderBrush="{Binding LatestStatus, Converter={StaticResource StatusToBrush}}">
                                            <Expander IsExpanded="False" Loaded="UpgradeLogExpander_Loaded" Expanded="UpgradeLogExpander_Expanded" Collapsed="UpgradeLogExpander_Collapsed">
                                                
                                                <Expander.Resources>
                                                    <CollectionViewSource x:Key="EntriesView" Source="{Binding Entries}">
                                                        <CollectionViewSource.SortDescriptions>
                                                            <scm:SortDescription PropertyName="TimeLocal" Direction="Descending"/>
                                                        </CollectionViewSource.SortDescriptions>
                                                    </CollectionViewSource>
                                                </Expander.Resources>

                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                                                            <TextBlock Text="{Binding LogIdMacPart}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding StartedAtLocalText}" />
                                                            <TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding Cassia}"/>
                                                            <TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding LatestMac}"/>
                                                            <TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding LastTimeLocalText}"/>

                                                            <Border Margin="12,0,0,0"
                                                                    Padding="8,2"
                                                                    CornerRadius="10"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding LatestStatus, Converter={StaticResource StatusToBrush}}">
                                                                <TextBlock Text="{Binding LatestStatus}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Grid.Row="1"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Text="{Binding LatestSummary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Expander.Header>

                                                <DataGrid ItemsSource="{Binding Source={StaticResource EntriesView}}"
                                                          Margin="0,10,0,0"
                                                          MaxHeight="420"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          HeadersVisibility="Column"
                                                          CanUserAddRows="False"
                                                          CanUserResizeRows="False"
                                                          CanUserSortColumns="False"
                                                          GridLinesVisibility="None" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" ScrollViewer.CanContentScroll="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Time" Binding="{Binding TimeLocalText}" Width="170"/>
                                                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*"/>
                                                        <DataGridTextColumn Header="FW" Binding="{Binding Firmware}" Width="90"/>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </DockPanel>
                </Border>
            </TabItem>

        </TabControl>
        </DockPanel>
    </Grid>
</Window>