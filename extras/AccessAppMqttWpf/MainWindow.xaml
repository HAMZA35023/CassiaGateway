<Window x:Class="AccessAppMqttWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AccessAppMqttWpf.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AccessAPP • MQTT Device Queue"
        Height="860" Width="1320"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>

        <!-- ONLINE / OFFLINE badge -->
        <DataTemplate x:Key="CassiaStateBadge">
            <Border x:Name="Badge"
                    CornerRadius="10"
                    Padding="8,2"
                    Background="#777">
                <TextBlock x:Name="Txt"
                           Text="UNKNOWN"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="online">
                    <Setter TargetName="Badge" Property="Background" Value="#2ECC71"/>
                    <Setter TargetName="Txt" Property="Text" Value="ONLINE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="offline">
                    <Setter TargetName="Badge" Property="Background" Value="#E74C3C"/>
                    <Setter TargetName="Txt" Property="Text" Value="OFFLINE"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Simple tabs styling -->
        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANEL ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ===== Cassia gateways (TOP LEFT) ===== -->
                    <TextBlock Text="Cassia gateways"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding CassiaGateways}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>

                                            <StackPanel Orientation="Vertical" Margin="0,6,0,0">

                                                <!-- Line 1 -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Last:" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding LastSeenLocal}" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0"/>

                                                    <TextBlock Text="Devices:" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DevicesSeen}" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0"/>

                                                    <TextBlock Text="In Queue:" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Queue}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <!-- Line 2 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="LastSeen:" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding LastSeenUtc}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </StackPanel>

                                        <ContentControl Grid.Column="1"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource CassiaStateBadge}"
                                                        VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ===== Connection ===== -->
                    <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="Host" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttHost}" Visibility="Collapsed"/>

                    <TextBlock Text="Port" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttPort}" Visibility="Collapsed"/>

                    <TextBlock Text="Topic" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttTopic}" Visibility="Collapsed"/>

                    <TextBlock Text="Username" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding MqttUser}" Visibility="Collapsed"/>

                    <TextBlock Text="Password" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" Visibility="Collapsed"/>

                    <CheckBox Content="Use TLS" IsChecked="{Binding UseTls}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <CheckBox Content="Ignore TLS certificate errors" IsChecked="{Binding IgnoreTlsErrors}" Margin="0,4,0,0" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="{Binding ConnectButtonText}"
                                Command="{Binding ToggleConnectCommand}"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="Save"
                                Command="{Binding SaveSettingsCommand}" Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ===== Scope / Network ===== -->
                    <TextBlock Text="Scope" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="NetworkId" Style="{StaticResource MetaLabel}"/>
                    <TextBox Text="{Binding NetworkId}"/>

                    <TextBlock Text="Command topic template" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding CommandTopicTemplate}" Visibility="Collapsed"/>

                    <TextBlock Text="Default command" Style="{StaticResource MetaLabel}" Visibility="Collapsed"/>
                    <TextBox Text="{Binding DefaultCommand}" Visibility="Collapsed"/>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ===== Firmware selection (DROPDOWNS) ===== -->
                    <TextBlock Text="Firmware selection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="P41 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP41}" SelectedItem="{Binding SelectedFirmwareP41}"/>

                    <TextBlock Text="P42 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP42}" SelectedItem="{Binding SelectedFirmwareP42}"/>

                    <TextBlock Text="P46 firmware (also P49)" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP46}" SelectedItem="{Binding SelectedFirmwareP46}"/>

                    <TextBlock Text="P47 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP47}" SelectedItem="{Binding SelectedFirmwareP47}"/>

                    <TextBlock Text="P48 firmware" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding FirmwareOptionsP48}" SelectedItem="{Binding SelectedFirmwareP48}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= RIGHT PANEL ================= -->
        <TabControl Grid.Column="2" Style="{StaticResource TabControlStyle}">

            <!-- ===== Devices ===== -->
            <TabItem Header="Devices">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <!-- TOP controls -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="  "/>
                            <TextBlock Text="{Binding DevicesSubtitle}" Foreground="{StaticResource MutedBrush}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Width="280" Text="{Binding DeviceFilter}" Margin="18,0,10,0"/>
                                <ComboBox Width="120" ItemsSource="{Binding SensorFilterOptions}" SelectedItem="{Binding SensorFilter}"/>
                                <CheckBox x:Name="EnableDoubleClickQueueCheckBox"
                                          Content="Double-click to queue"
                                          IsChecked="{Binding EnableDoubleClickQueue, Mode=TwoWay}"
                                          Margin="14,0,10,0"
                                          VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Clear"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Click="ClearDevices_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="220"/>
                            </Grid.RowDefinitions>

                            <!-- Discovered devices -->
                            <DataGrid x:Name="DevicesGrid"
                                      Grid.Row="0"
                                      ItemsSource="{Binding FilteredDevices}"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      MouseDoubleClick="DevicesGrid_MouseDoubleClick"
                                      IsReadOnly="True"
                                      CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="32" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Focusable="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Update FW" Width="100" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}" Content="Update" Padding="10,4"
                                                        Click="UpdateFw_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductNumber}" Width="120"/>
                                    <DataGridTextColumn Header="Model" Binding="{Binding SensorModel}" Width="70"/>
                                    <DataGridTextColumn Header="RSSI" Binding="{Binding BestRssi}" Width="70"/>
                                    <DataGridTextColumn Header="Cassia" Binding="{Binding BestCassia}" Width="110"/>

                                    <DataGridTextColumn Header="Status" Binding="{Binding ProcessStatus}" Width="120"/>
                                    <DataGridTextColumn Header="%" Binding="{Binding ProcessProgress}" Width="60"/>
                                    <DataGridTextColumn Header="FW" Binding="{Binding ProcessFirmware}" Width="90"/>
                                    <DataGridTextColumn Header="Current FW" Binding="{Binding CurrentFw}" Width="90"/>

                                    <DataGridTemplateColumn Header="Get FW" Width="90" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}" Content="Get FW" Padding="10,4"
                                                        Click="GetFw_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Proc Cassia" Binding="{Binding ProcessCassia}" Width="110"/>
                                    <DataGridTextColumn Header="Proc Time" Binding="{Binding ProcessLastUpdateLocal}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- ===== MOVED FROM QUEUE TAB TO HERE ===== -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,12,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Queue actions" FontWeight="SemiBold"/>
                                        <TextBlock Text="  " />
                                        <TextBlock Text="(operate on selected devices above)" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- This is the button you wanted moved -->
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Queue selected"
                                                Command="{Binding QueueSelectedCommand}"
                                                Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource GhostButton}"
                                                Content="Clear queue"
                                                Command="{Binding ClearQueueCommand}"
                                                Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource GhostButton}"
                                                Content="Default sort"
                                                Padding="12,6"
                                                Click="QueueDefaultSort_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Queue list below discovered devices -->
                            <DockPanel Grid.Row="2">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Queued devices" FontWeight="SemiBold"/>
                                    <TextBlock Text="  " />
                                    <TextBlock Text="(same data as Queue tab)" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>

                                <DataGrid x:Name="QueueGridInline"
                                          ItemsSource="{Binding QueueView}"
                                          SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160"/>
                                        <DataGridTextColumn Header="Cassia" Binding="{Binding Cassia}" Width="110"/>
                                        <DataGridTextColumn Header="Model" Binding="{Binding DetectorType}" Width="70"/>
                                        <DataGridTextColumn Header="FW" Binding="{Binding FirmwareVersion}" Width="90"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="260"/>
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== Queue (kept, but now WITHOUT "Queue selected") ===== -->
            <TabItem Header="Queue">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Queue" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>

                        <DataGrid x:Name="QueueGrid"
                                  ItemsSource="{Binding QueueView}"
                                  SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  Sorting="QueueGrid_Sorting">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160"/>
                                <DataGridTextColumn Header="Cassia" Binding="{Binding Cassia}" Width="110"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding DetectorType}" Width="70"/>
                                <DataGridTextColumn Header="FW" Binding="{Binding FirmwareVersion}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                                <DataGridTemplateColumn Header="%" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Progress, StringFormat={}{0}%}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="queued">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== Upgrade log ===== -->
            <TabItem Header="Upgrade log">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="Upgrade log" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="  " />
                            <TextBlock Text="{Binding UpgradeLogSummary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                            <TextBlock Text="   Search:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            <TextBox Width="220"
                                     Text="{Binding UpgradeLogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,0,0">
                                <ComboBox Width="160"
                                          ItemsSource="{Binding LogGatewayOptions}"
                                          SelectedItem="{Binding SelectedLogGatewayName}"
                                          Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Request"
                                        Command="{Binding RequestUpgradeLogCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Clear"
                                        Command="{Binding ClearUpgradeLogCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding UpgradeLogGroupsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}"
                                                BorderThickness="2"
                                                Padding="10"
                                                Margin="0,0,0,10"
                                                CornerRadius="10"
                                                BorderBrush="{Binding LatestStatus, Converter={StaticResource StatusToBrush}}">
                                            <Expander IsExpanded="False">
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                                                            <TextBlock Text="{Binding LogIdMacPart}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding StartedAtLocalText}" />
                                                            <TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding Cassia}"/>
                                                            <TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding LatestMac}"/>
                                                            <TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding LastTimeLocalText}"/>

                                                            <Border Margin="12,0,0,0"
                                                                    Padding="8,2"
                                                                    CornerRadius="10"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding LatestStatus, Converter={StaticResource StatusToBrush}}">
                                                                <TextBlock Text="{Binding LatestStatus}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Grid.Row="1"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Text="{Binding LatestSummary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Expander.Header>

                                                <DataGrid ItemsSource="{Binding Entries}"
                                                          Margin="0,10,0,0"
                                                          MaxHeight="420"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          HeadersVisibility="Column"
                                                          CanUserAddRows="False"
                                                          CanUserResizeRows="False"
                                                          CanUserSortColumns="False"
                                                          GridLinesVisibility="None">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Time" Binding="{Binding TimeLocalText}" Width="170"/>
                                                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*"/>
                                                        <DataGridTextColumn Header="FW" Binding="{Binding Firmware}" Width="90"/>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </DockPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
