<Window x:Class="AccessAppMqttWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AccessAppMqttWpf.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AC Controller for AccessAPP - v0.11.1"
        Height="941" Width="1715"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MenuIconGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
        <SolidColorBrush x:Key="DoneRowBrush" Color="#2A22C55E"/>
        <SolidColorBrush x:Key="QueueRowBrush" Color="#2A60A5FA"/>
        <SolidColorBrush x:Key="WarnRowBrush" Color="#2AFACC15"/>
        <SolidColorBrush x:Key="NoFwRowBrush" Color="#2A06B6D4"/>
        <SolidColorBrush x:Key="FailedRowBrush" Color="#2AE74C3C"/>


        <!-- ONLINE / OFFLINE badge -->
        <DataTemplate x:Key="CassiaStateBadge">
            <Border x:Name="Badge"
                    CornerRadius="10"
                    Padding="10,3"
                    Background="#777">
                <TextBlock x:Name="Txt"
                           Text="UNKNOWN"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="online">
                    <Setter TargetName="Badge" Property="Background" Value="#2ECC71"/>
                    <Setter TargetName="Txt" Property="Text" Value="ONLINE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="offline">
                    <Setter TargetName="Badge" Property="Background" Value="#E74C3C"/>
                    <Setter TargetName="Txt" Property="Text" Value="OFFLINE"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Refresh badge button (same style as ONLINE/OFFLINE badge) -->
        <Style x:Key="CassiaBadgeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="#777"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="online">
                    <Setter Property="Background" Value="#2ECC71"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="offline">
                    <Setter Property="Background" Value="#E74C3C"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CassiaBadgeButtonStyleWarning" TargetType="Button">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="#777"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="online">
                    <Setter Property="Background" Value="Orange"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="offline">
                    <Setter Property="Background" Value="#E74C3C"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Simple tabs styling -->
        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource Card2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProgressBarCellTemplate">
            <Grid Height="16" MinWidth="50">
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding Progress}"
                             Background="{DynamicResource Card2Brush}"
                             Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="queued">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Queued">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProcessProgressBarCellTemplate">
            <Grid Height="16" MinWidth="40">
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ProcessProgress}"
                             Background="{DynamicResource Card2Brush}"
                             Foreground="{DynamicResource GoodBrush}"/>
                <TextBlock Text="{Binding ProcessProgress, StringFormat={}{0}%}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="UpgradeLogTabPlaceholderTemplate">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Upgrade log will load when you open this tab."
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="UpgradeLogTabContentTemplate">
            <Border Style="{StaticResource Card}">
                <DockPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Upgrade log" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <TextBlock Text="   Search:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            <TextBox Width="220"
                                     Text="{Binding UpgradeLogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"/>

                            <!-- UPDATED: add (LogId dropdown) + keep existing gateway dropdown + request/clear buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,0,0">
                                    <ComboBox Width="160"
                                          ItemsSource="{Binding LogGatewayOptions}"
                                          SelectedItem="{Binding SelectedLogGatewayName}"
                                          Margin="0,0,8,0"/>

                                    <ComboBox Width="130"
                                          ItemsSource="{Binding UpgradeLogShowOptions}"
                                          SelectedItem="{Binding SelectedUpgradeLogShowOption}"
                                          Margin="0,0,8,0"/>

                                <CheckBox Content="Latest per MAC"
                                          IsChecked="{Binding UpgradeLogLatestOnlyPerMac, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>

                                <Button Style="{StaticResource GhostButton}"
                                        Content="Export"
                                        Padding="12,6"
                                        Command="{Binding ExportUpgradeLogToExcelCommand}"
                                        Margin="0,0,8,0"/>


                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Request"
                                        Command="{Binding RequestUpgradeLogCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Clear on Cassia"
                                        Command="{Binding ClearUpgradeLogOnCassiaCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Clear"
                                        Command="{Binding ClearUpgradeLogCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Margin="0,6,0,0"
                                   Text="{Binding UpgradeLogUniqueSummary}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox ItemsSource="{Binding UpgradeLogGroupsView}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.IsDeferredScrollingEnabled="True"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderThickness="2"
                                            Padding="10"
                                            Margin="0,0,0,10"
                                            CornerRadius="10"
                                            BorderBrush="{Binding DisplayBadgeStatus, Converter={StaticResource StatusToBrush}}"
                                            HorizontalAlignment="Stretch">
                                        <Expander IsExpanded="False" Loaded="UpgradeLogExpander_Loaded" Expanded="UpgradeLogExpander_Expanded" Collapsed="UpgradeLogExpander_Collapsed">

                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                                            <TextBlock Text="{Binding LogIdMacPart}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="  â€¢  " Foreground="{DynamicResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding StartedAtLocalText}" />
                                                            <TextBlock Text="  â€¢  " Foreground="{DynamicResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding Cassia}"/>
                                                            <TextBlock Text="  â€¢  " Foreground="{DynamicResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding LatestMacWithName}"/>
                                                            <TextBlock Text="  â€¢  " Foreground="{DynamicResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding LastTimeLocalText}"/>
                                                            <TextBlock Text="  â€¢  TOTAL TIME: " Foreground="{DynamicResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding TotalDurationText}" />
                                                            <TextBlock Text="m" Foreground="{DynamicResource MutedBrush}"/>


                                                            <Border Margin="12,0,0,0"
                                                                Padding="8,2"
                                                                CornerRadius="10"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding DisplayBadgeStatus, Converter={StaticResource StatusToBrush}}">
                                                            <TextBlock Text="{Binding DisplayBadgeStatus}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="1"
                                                               Margin="0,4,0,0"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               Text="{Binding LatestSummary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Expander.Header>

                                            <DataGrid ItemsSource="{Binding Entries}"
                                                      Margin="0,10,0,0"
                                                      MaxHeight="420"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      CanUserResizeRows="False"
                                                      CanUserSortColumns="False"
                                                      GridLinesVisibility="None" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" ScrollViewer.CanContentScroll="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeLocalText}" Width="140"/>
                                                    <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="400"/>
                                                    <DataGridTextColumn Header="FW" Binding="{Binding Firmware}" Width="80"/>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <DockPanel Margin="0" Background="{DynamicResource BgBrush}">
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource CardBrush}"
              Foreground="{DynamicResource TextBrush}">
            <MenuItem Header="Cassia">
                <MenuItem.Icon>
                    <TextBlock Text="📡" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
                <MenuItem Header="Speed graph (all)" Command="{Binding OpenSpeedGraphAllCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="📈" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="LED range visualizer (all)" Command="{Binding OpenLedRangeVisualizerAllCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="💡" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Refresh FW manifest (all)" Command="{Binding RefreshFwManifestForAllCassiasCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🔄" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Clear backups (all)" Command="{Binding ClearDeviceSettingsBackupsForAllCassiasCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🧹" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Set MQTT broker (all)..." Command="{Binding SetMqttBrokerForAllCassiasPromptCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🌐" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Set runtime variables (all)..."
                          Visibility="{Binding DeveloperModeUnlocked, Converter={StaticResource BoolToVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}"
                          Command="{Binding OpenRuntimeSettingsAllCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Cassia web settings (all)..."
                          Visibility="{Binding DeveloperModeUnlocked, Converter={StaticResource BoolToVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}"
                          Command="{Binding OpenCassiaSettingsFirstOnlineCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🛠" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Remote self-update (all)"
                          Visibility="{Binding DeveloperModeUnlocked, Converter={StaticResource BoolToVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}"
                          Command="{Binding SelfUpdateAllCassiasCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="⬆" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Reboot all Cassias (all)"
                          Visibility="{Binding DeveloperModeUnlocked, Converter={StaticResource BoolToVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}"
                          Command="{Binding RebootAllCassiasCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="⏻" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Set parallel (all)" Command="{Binding SetParallelProgrammersForAllCassiasPromptCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Get parallel (all)" Command="{Binding GetParallelProgrammersForAllCassiasCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🔍" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Theme">
                <MenuItem.Icon>
                    <TextBlock Text="🎨" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
                <MenuItem x:Name="ThemeLightMenuItem"
                          Header="Light"
                          IsCheckable="True"
                          Click="ThemeLight_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="☀" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="ThemeDarkMenuItem"
                          Header="Dark"
                          IsCheckable="True"
                          Click="ThemeDark_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="☾" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Devices">
                <MenuItem.Icon>
                    <TextBlock Text="🧩" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
                <MenuItem Header="Detector settings (new profile)..."
                          Visibility="{Binding DeveloperModeUnlocked, Converter={StaticResource BoolToVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}"
                          Command="{Binding OpenDetectorSettingsNewProfileCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="📝" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Detector settings (selected)..."
                          Visibility="{Binding DeveloperModeUnlocked, Converter={StaticResource BoolToVis}, TargetNullValue=Collapsed, FallbackValue=Collapsed}"
                          Command="{Binding OpenDetectorSettingsForSelectedCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Remove all ignored devices"
                          Command="{Binding ClearIgnoredDevicesCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🗑" Style="{StaticResource MenuIconGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource CardBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   Margin="0,10,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusBarText}" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" HorizontalContentAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="UI update cadence" Opacity="0.85" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ProgressUiCountdownText}" Margin="0,0,14,0" Opacity="0.85"/>
                    <TextBlock Text="{Binding DiscoveredUiCountdownText}" Opacity="0.85"/>
                    <TextBlock Text="   " Opacity="0.85"/>
                    <TextBlock Text="{Binding TotalSpeedStatusText}" Foreground="{DynamicResource MutedBrush}"/>
                    <Button Style="{StaticResource GhostButton}"
                            Content="Refresh UI"
                            Padding="12,6"
                            Margin="14,0,0,0"
                            Command="{Binding RefreshUiNowCommand}"
                            Visibility="Collapsed"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANEL ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ===== Cassia gateways (TOP LEFT) ===== -->
                    <TextBlock Text="Cassia gateways"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding CassiaGateways}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                                                <Border Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Margin="0,0,0,8"
        HorizontalAlignment="Stretch"
        ContextMenuOpening="CassiaTile_ContextMenuOpening"
        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

    <Border.ContextMenu>
        <!-- ContextMenu is rendered in a Popup (separate visual tree), so it cannot use AncestorType=Window.
             Bind via PlacementTarget instead. -->
        <ContextMenu>
            <MenuItem Header="Set Cassia name..."
                      Command="{Binding PlacementTarget.Tag.SetCassiaNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="✏" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Set identity (name + networkId)..."
                      Command="{Binding PlacementTarget.Tag.SetCassiaIdentityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="👤" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Set MQTT scope (networkId)..."
                      Command="{Binding PlacementTarget.Tag.SetCassiaMqttScopeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="🧭" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Set MQTT broker (host/port/tls)..."
                      Command="{Binding PlacementTarget.Tag.SetCassiaMqttBrokerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="🌐" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Visibility="{Binding PlacementTarget.Tag.DeveloperModeUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Set runtime variables..."
                      Visibility="{Binding PlacementTarget.Tag.DeveloperModeUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                      Command="{Binding PlacementTarget.Tag.OpenRuntimeSettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="⚙" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Cassia web settings..."
                      Visibility="{Binding PlacementTarget.Tag.DeveloperModeUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                      Command="{Binding PlacementTarget.Tag.OpenCassiaSettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="🛠" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Remote self-update (restart service)"
                      Visibility="{Binding PlacementTarget.Tag.DeveloperModeUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                      Command="{Binding PlacementTarget.Tag.SelfUpdateCassiaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="⬆" Style="{StaticResource MenuIconGlyph}"/>
                </MenuItem.Icon>
