<Window x:Class="AccessAppMqttWpf.RuntimeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AccessAppMqttWpf.Models"
        Title="Runtime Variables"
        Height="560" Width="820"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="RuntimeBoolTemplate">
            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="RuntimeTextTemplate">
            <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="220"
                     Margin="0"
                     VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="RuntimeVariableRowTemplate" DataType="{x:Type models:RuntimeVariableItem}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           ToolTip="{Binding Name}"
                           TextTrimming="CharacterEllipsis"/>

                <ContentControl Grid.Column="1" Content="{Binding}" HorizontalAlignment="Left">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource RuntimeTextTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:RuntimeVariableKind.Bool}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource RuntimeBoolTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RuntimeTabHeaderTemplate" DataType="{x:Type models:RuntimeVariableGroup}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource Card2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="6,0,0,0"
                        Padding="6,1">
                    <TextBlock Text="{Binding Variables.Count}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Set runtime variables" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TargetLabel, StringFormat=Target: {0}}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl ItemsSource="{Binding VariableGroups}"
                            SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                            ItemTemplate="{StaticResource RuntimeTabHeaderTemplate}">
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type models:RuntimeVariableGroup}">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="{Binding Title, StringFormat=Category: {0}}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Edit values and use Apply to send all runtime variables."/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Key}" Value="unorganized">
                                                        <Setter Property="Text" Value="New or unmapped runtime variables appear here so they are never hidden."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Variables}"
                                                      ItemTemplate="{StaticResource RuntimeVariableRowTemplate}"/>
                                        <TextBlock Text="No variables in this tab."
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,10,0,0"
                                                   Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Variables.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <TextBlock Grid.Row="1"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Refresh" Padding="18,8" Margin="0,0,8,0"
                    Command="{Binding RefreshCommand}"/>
            <Button Style="{StaticResource GhostButton}" Content="Cancel" Padding="18,8" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Apply" Padding="18,8"
                    Command="{Binding ApplyCommand}"/>
        </StackPanel>
    </Grid>
</Window>
