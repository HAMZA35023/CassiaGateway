<Window x:Class="AccessAppMqttWpf.RuntimeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AccessAppMqttWpf.Models"
        Title="Runtime Variables"
        Height="560" Width="820"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="RuntimeBoolTemplate">
            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="RuntimeTextTemplate">
            <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="160" VerticalAlignment="Center"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Set runtime variables" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TargetLabel, StringFormat=Target: {0}}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Variables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RuntimeVariableItem}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="560"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <ContentControl Grid.Column="1" Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource RuntimeTextTemplate}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:RuntimeVariableKind.Bool}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource RuntimeBoolTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Refresh" Padding="18,8" Margin="0,0,8,0"
                    Command="{Binding RefreshCommand}"/>
            <Button Style="{StaticResource GhostButton}" Content="Cancel" Padding="18,8" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Apply" Padding="18,8"
                    Command="{Binding ApplyCommand}"/>
        </StackPanel>
    </Grid>
</Window>

