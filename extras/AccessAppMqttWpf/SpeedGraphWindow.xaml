<Window x:Class="AccessAppMqttWpf.SpeedGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccessAPP - Speed Graph"
        Height="600" Width="1040"
        WindowStartupLocation="CenterOwner"
        MinHeight="420" MinWidth="780"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0"
                CornerRadius="10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource CardBrush}"
                Padding="10"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Graph name + averages -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock x:Name="GraphTitleText"
                               Text="Speed"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Avg 15m:"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="Avg15Text"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0"/>

                        <TextBlock Text="Avg 30m:"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="Avg30Text"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0"/>

                        <TextBlock Text="Range:"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="RangeText"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- RIGHT: selectors + buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Gateway:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,6,0"/>
                    <ComboBox x:Name="GatewayCombo"
                              Width="260"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedGatewayOption, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectionChanged="GatewayCombo_SelectionChanged"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"/>

                    <TextBlock Text="Timeframe:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,6,0"/>
                    <ComboBox x:Name="TimeframeCombo"
                              Width="150"
                              VerticalAlignment="Center"
                              SelectionChanged="TimeframeCombo_SelectionChanged"
                              Margin="0,0,14,0">
                        <ComboBoxItem Content="15 min" Tag="00:15:00"/>
                        <ComboBoxItem Content="30 min" Tag="00:30:00"/>
                        <ComboBoxItem Content="1 hour" Tag="01:00:00" IsSelected="True"/>
                        <ComboBoxItem Content="2 hours" Tag="02:00:00"/>
                        <ComboBoxItem Content="6 hours" Tag="06:00:00"/>
                        <ComboBoxItem Content="12 hours" Tag="12:00:00"/>
                        <ComboBoxItem Content="Custom (drag)" Tag="CUSTOM"/>
                    </ComboBox>

                    <Button Content="Reset zoom"
                            Width="110"
                            Margin="0,0,8,0"
                            Click="ResetZoom_Click"/>
                    <Button Content="Close"
                            Width="90"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chart area -->
        <Border Grid.Row="1"
                CornerRadius="14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource CardBrush}"
                Padding="12"
                SnapsToDevicePixels="True"
                Margin="0,10,0,0">
            <Grid>
                <Canvas x:Name="ChartCanvas"
                        Background="Transparent"
                        SnapsToDevicePixels="True" />

                <Canvas x:Name="OverlayCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                        MouseMove="OverlayCanvas_MouseMove"
                        MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding ElementName=ChartCanvas, Path=Tag}"
                       Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="Tip: drag on the chart to zoom (Custom). Double-click or Reset zoom to restore."
                       Foreground="{DynamicResource MutedBrush}"/>
        </DockPanel>
    </Grid>
</Window>
