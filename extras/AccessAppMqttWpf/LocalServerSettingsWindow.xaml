<Window x:Class="AccessAppMqttWpf.LocalServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Server Settings"
        Height="660" Width="680"
        MinHeight="800" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Local Server Settings"
                           FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Host a local MQTT broker and manage a locally installed AccessApp instance."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── MQTT Server ── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Local MQTT Server"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Port" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding MqttPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{Binding StartStopServerLabel}"
                            Command="{Binding ToggleServerCommand}"
                            MinWidth="120" Margin="0,0,12,0"/>
                    <Border Background="{DynamicResource Card2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,4">
                        <TextBlock Text="{Binding LocalServerStatus}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Cassia Gateway IPs ── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Cassia Gateway IPs"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,4"/>

                <CheckBox Content="Use shared network ID for local connection"
                          IsChecked="{Binding UseSharedNetworkId, Mode=TwoWay}"
                          Margin="0,0,0,4"
                          ToolTip="When enabled, all AccessApp instances use the WPF's network ID on the local broker instead of their own configured ID."/>
                <TextBlock Text="All gateways will subscribe and publish under the same network ID on the local broker. Only affects the local connection — their own configured ID is unchanged."
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="20,0,0,10"/>

                <CheckBox Content="Send MQTT host IP to AccessApp"
                          IsChecked="{Binding SendMqttHost, Mode=TwoWay}"
                          Margin="0,0,0,4"
                          ToolTip="When enabled, WPF probes its outbound IP and sends it in the config push. Required when AccessApp runs inside a NAT container (e.g. Cassia LXC). Disable if there is no NAT — AccessApp will then use the TCP connection's source IP instead."/>
                <TextBlock Text="Enable when AccessApp runs inside a NAT container (Cassia LXC). Disable for direct connections — AccessApp will detect the WPF IP automatically from the TCP connection."
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="20,0,0,10"/>

            </StackPanel>
        </Border>

        <!-- ── AccessApp ── -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Local AccessApp"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <!-- Channel / Manifest / Runtime -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding AccessAppChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Manifest base URL" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding ManifestBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Runtime" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  ItemsSource="{Binding RuntimeOptions}"
                                  SelectedItem="{Binding SelectedRuntime, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Divider -->
                    <Separator Margin="0,8,0,8"/>

                    <!-- Local path override -->
                    <TextBlock Text="Local path override"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Leave empty to use the auto-download directory. Set to use a manually installed AccessApp."
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding LocalAccessAppPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 Cursor="Arrow"
                                 PreviewMouseLeftButtonDown="LocalPathBox_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Column="1" Content="Browse…"
                                Command="{Binding BrowseLocalPathCommand}"
                                MinWidth="70" Margin="6,0,0,0"/>
                        <Button Grid.Column="2" Content="Clear"
                                Command="{Binding ClearLocalPathCommand}"
                                MinWidth="50" Margin="4,0,0,0"/>
                    </Grid>

                    <!-- Divider -->
                    <Separator Margin="0,10,0,10"/>

                    <!-- Installed version + download -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Installed version" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                MinWidth="160"
                                Command="{Binding DownloadUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Download / Update"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Content" Value="Cancel download"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ProgressBar Grid.Column="1"
                                     Margin="10,0,0,0"
                                     Height="20"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding DownloadProgress}"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Divider -->
                    <Separator Margin="0,10,0,10"/>

                    <!-- Auto-start + start/stop -->
                    <CheckBox Content="Auto-start local server on application startup"
                              IsChecked="{Binding AutoStartLocalServer, Mode=TwoWay}"
                              Margin="0,0,0,6"/>
                    <CheckBox Content="Auto-start AccessApp when local server starts"
                              IsChecked="{Binding AutoStartAccessApp, Mode=TwoWay}"
                              Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding StartStopAccessAppLabel}"
                                Command="{Binding ToggleAccessAppCommand}"
                                MinWidth="140" Margin="0,0,12,0"/>
                        <Border Background="{DynamicResource Card2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,4">
                            <TextBlock Text="{Binding AccessAppProcessStatus}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Status + buttons ── -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusText}"/>

            <Button Grid.Column="1"
                    Content="Save"
                    Command="{Binding SaveSettingsCommand}"
                    MinWidth="80" Margin="0,0,8,0"/>
            <Button Grid.Column="2"
                    Content="Close"
                    Click="Close_Click"
                    MinWidth="80"/>
        </Grid>
    </Grid>
</Window>
