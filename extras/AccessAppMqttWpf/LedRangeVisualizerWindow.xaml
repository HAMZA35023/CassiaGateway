<Window x:Class="AccessAppMqttWpf.LedRangeVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LED Range Visualizer"
        Height="760" Width="1380"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Cassia LED Range Visualizer" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Connect/login devices by RSSI, set LED color by RSSI, keep links until explicit disconnect."
                           Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Cassia" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding CassiaNameOptions}"
                              SelectedItem="{Binding LedRangeCassia, Mode=TwoWay}"
                              IsEditable="True"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Min RSSI" Style="{StaticResource MetaLabel}"/>
                    <TextBox Text="{Binding LedRangeMinRssi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Model" Style="{StaticResource MetaLabel}"/>
                    <ComboBox ItemsSource="{Binding LedRangeModelOptions}"
                              SelectedItem="{Binding SelectedLedRangeModel, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Retries" Style="{StaticResource MetaLabel}"/>
                    <TextBox Text="{Binding LedRangeMaxConnectAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="Pincode" Style="{StaticResource MetaLabel}"/>
                    <TextBox Text="{Binding LedRangePincode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Content="Start visualization" Padding="14,8"
                            Command="{Binding StartLedRangeVisualizationCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource WarningButton}" Content="Retry failed" Padding="14,8"
                            Command="{Binding RetryFailedLedRangeDevicesCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource DangerButton}" Content="Disconnect session" Padding="14,8"
                            Command="{Binding DisconnectLedRangeSessionCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource DangerButton}" Content="Force disconnect all" Padding="14,8"
                            Command="{Binding ForceDisconnectAllLedRangeSessionCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Progress" FontWeight="SemiBold"/>
                    <ProgressBar Height="14" Margin="0,8,0,4" Minimum="0" Maximum="100" Value="{Binding LedRangeProgressPercent}"/>
                    <TextBlock Text="{Binding LedRangeProgressText}" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LedRangeConnectedCount, StringFormat=Connected: {0}}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding LedRangeFailedCount, StringFormat=Failed: {0}}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding LedRangeRequestedTotal, StringFormat=Total: {0}}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Connected devices" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding LedRangeConnectedDevices}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="200"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                        <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="80"/>
                        <DataGridTextColumn Header="Chip" Binding="{Binding Chip}" Width="70"/>
                        <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Failed devices" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{Binding LedRangeStatusText}" Foreground="{DynamicResource MutedBrush}"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding LedRangeFailedDevices}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="200"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                        <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="80"/>
                        <DataGridTextColumn Header="Chip" Binding="{Binding Chip}" Width="70"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                        <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>

