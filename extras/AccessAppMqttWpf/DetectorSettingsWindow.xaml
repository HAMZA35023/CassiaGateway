<Window x:Class="AccessAppMqttWpf.DetectorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AccessAppMqttWpf.ViewModels"
        Title="{Binding WindowTitle}"
        Height="900"
        Width="1450"
        MinHeight="760"
        MinWidth="1180"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="NumberEditorTemplate" DataType="{x:Type vm:DetectorFieldRowViewModel}">
            <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="90"
                     VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="EnumEditorTemplate" DataType="{x:Type vm:DetectorFieldRowViewModel}">
            <ComboBox ItemsSource="{Binding Options}"
                      DisplayMemberPath="Label"
                      MaxDropDownHeight="520"
                      MinWidth="220"
                      ToolTip="{Binding Description}"
                      TextSearch.TextPath="Label"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedOptionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="False"/>
        </DataTemplate>

        <DataTemplate x:Key="BoolEditorTemplate" DataType="{x:Type vm:DetectorFieldRowViewModel}">
            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"/>
        </DataTemplate>

        <DataTemplate x:Key="HexEditorTemplate" DataType="{x:Type vm:DetectorFieldRowViewModel}">
            <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"
                     MinWidth="120"
                     VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldEditorTemplate" DataType="{x:Type vm:DetectorFieldRowViewModel}">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource NumberEditorTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnumEditor}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource EnumEditorTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBoolEditor}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource BoolEditorTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHexEditor}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource HexEditorTemplate}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="SettingsRowsGridTemplate">
            <DataGrid ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeight="38"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Apply" Binding="{Binding IsSelected, Mode=TwoWay}" Width="70"/>
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Field" Binding="{Binding Label}" Width="210" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Value" CellTemplate="{StaticResource FieldEditorTemplate}" Width="2*"/>
                    <DataGridTextColumn Header="Current" Binding="{Binding CurrentValueText}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Detector settings editor" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Pick specific fields to overwrite. The app sends field masks so only selected fields are changed."
                           Margin="0,4,0,10"
                           Foreground="{DynamicResource MutedBrush}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="Write only changed sections"
                              IsChecked="{Binding WriteOnlyChanged, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding ProfilePath}"
                             IsReadOnly="True"
                             Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <TabControl>
                <TabItem Header="User Config">
                    <TabControl>
                        <TabItem Header="General">
                            <ContentControl Content="{Binding UserGeneralRows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="Zone 1">
                            <ContentControl Content="{Binding UserZone1Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="Zone 2">
                            <ContentControl Content="{Binding UserZone2Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="Zone 3">
                            <ContentControl Content="{Binding UserZone3Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="Zone 4">
                            <ContentControl Content="{Binding UserZone4Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="Zone 5">
                            <ContentControl Content="{Binding UserZone5Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="Wired PB">
                    <TabControl>
                        <TabItem Header="General">
                            <ContentControl Content="{Binding WiredGeneralRows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 1">
                            <ContentControl Content="{Binding WiredPb1Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 2">
                            <ContentControl Content="{Binding WiredPb2Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 3">
                            <ContentControl Content="{Binding WiredPb3Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 4">
                            <ContentControl Content="{Binding WiredPb4Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="BLE PB">
                    <TabControl>
                        <TabItem Header="General">
                            <ContentControl Content="{Binding BleGeneralRows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 1">
                            <ContentControl Content="{Binding BlePb1Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 2">
                            <ContentControl Content="{Binding BlePb2Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 3">
                            <ContentControl Content="{Binding BlePb3Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 4">
                            <ContentControl Content="{Binding BlePb4Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="DALI PB">
                    <TabControl>
                        <TabItem Header="General">
                            <ContentControl Content="{Binding DaliGeneralRows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 1">
                            <ContentControl Content="{Binding DaliPb1Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 2">
                            <ContentControl Content="{Binding DaliPb2Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 3">
                            <ContentControl Content="{Binding DaliPb3Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="PB 4">
                            <ContentControl Content="{Binding DaliPb4Rows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="DALI Devices">
                    <TabControl>
                        <TabItem Header="Levels">
                            <ContentControl Content="{Binding DaliCommonLevelRows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                        <TabItem Header="Fade">
                            <ContentControl Content="{Binding DaliCommonFadeRows}" ContentTemplate="{StaticResource SettingsRowsGridTemplate}"/>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="Profile Run">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Post-update DALI actions stored in the profile file"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <CheckBox Grid.Row="1"
                                  Content="Run DALI profile run (0x0400, SearchType=0x00): address all control gear and assign zone 1"
                                  IsChecked="{Binding RunDaliAddressAllToZone1AfterUpdate, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Grid.Row="2"
                                  Content="Run DALI 102 total-new scan (0x0400, SearchType=0x01)"
                                  IsChecked="{Binding RunDali102TotalNewScanAfterUpdate, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <CheckBox Grid.Row="3"
                                  Content="Run DALI 103 total-new scan (0x0400, SearchType=0x03)"
                                  IsChecked="{Binding RunDali103TotalNewScanAfterUpdate, Mode=TwoWay}"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Tunable White">
                    <TabControl>
                        <TabItem Header="Schedule">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Apply Tunable White List (full write)"
                                              IsChecked="{Binding ApplyTunableWhiteList, Mode=TwoWay}"
                                              Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding SelectedTunableWhiteSectionCount, StringFormat=Selected TW sections: {0}}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                                    <TextBlock Text="Version" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="56"
                                             Margin="0,0,14,0"
                                             Text="{Binding TunableWhiteListVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="Schedule enabled"
                                              IsChecked="{Binding TunableWhiteListEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Set all 24h Kelvin" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="72"
                                             Margin="0,0,8,0"
                                             Text="{Binding TunableWhiteScheduleAllKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Apply Kelvin"
                                            Padding="12,4"
                                            Margin="0,0,14,0"
                                            Command="{Binding ApplyTunableWhiteScheduleKelvinToAllHoursCommand}"/>
                                    <TextBlock Text="Set all 24h Lux" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="72"
                                             Margin="0,0,10,0"
                                             Text="{Binding TunableWhiteScheduleAllLux, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Apply Lux"
                                            Padding="12,4"
                                            Command="{Binding ApplyTunableWhiteScheduleLuxToAllHoursCommand}"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="3"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Grid MinHeight="430">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Text="Kelvin graph (1800..6500 K, snap 100 K). Drag points with mouse."
                                                           Margin="0,0,0,6"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <Canvas x:Name="KelvinScheduleCanvas"
                                                        Grid.Row="1"
                                                        MinHeight="180"
                                                        Background="#FFF9F2E8"
                                                        MouseLeftButtonDown="KelvinScheduleCanvas_MouseLeftButtonDown"
                                                        MouseMove="KelvinScheduleCanvas_MouseMove"
                                                        MouseLeftButtonUp="ScheduleCanvas_MouseLeftButtonUp"
                                                        MouseLeave="ScheduleCanvas_MouseLeave"
                                                        SizeChanged="ScheduleCanvas_SizeChanged"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Text="Lux graph (20..2000 lx, snap 10 lx). Drag points with mouse."
                                                           Margin="0,0,0,6"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <Canvas x:Name="LuxScheduleCanvas"
                                                        Grid.Row="1"
                                                        MinHeight="180"
                                                        Background="#FFEFF7FD"
                                                        MouseLeftButtonDown="LuxScheduleCanvas_MouseLeftButtonDown"
                                                        MouseMove="LuxScheduleCanvas_MouseMove"
                                                        MouseLeftButtonUp="ScheduleCanvas_MouseLeftButtonUp"
                                                        MouseLeave="ScheduleCanvas_MouseLeave"
                                                        SizeChanged="ScheduleCanvas_SizeChanged"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Presets">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                          Content="Apply Tunable White Presets (full write)"
                                          IsChecked="{Binding ApplyTunableWhitePreset, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Width="56" HorizontalAlignment="Left"
                                         Text="{Binding TunableWhitePresetVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Preset 1" VerticalAlignment="Top" Margin="0,2,8,8"/>
                                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Kelvin" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="1800" Maximum="6500" TickFrequency="100" IsSnapToTickEnabled="True"
                                            Value="{Binding TunableWhitePreset1Kelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TunableWhitePreset1Kelvin, StringFormat={}{0} K}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Lux" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding TunableWhitePreset1Lux, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TunableWhitePreset1Lux, StringFormat={}{0} lux}" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,8">
                                    <Border Height="18" Background="{Binding TunableWhitePreset1Brush}" CornerRadius="3" Margin="0,0,0,4"/>
                                    <Border Height="18" Background="{Binding TunableWhitePreset1LuxBrush}" CornerRadius="3"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Preset 2" VerticalAlignment="Top" Margin="0,2,8,8"/>
                                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Kelvin" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="1800" Maximum="6500" TickFrequency="100" IsSnapToTickEnabled="True"
                                            Value="{Binding TunableWhitePreset2Kelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TunableWhitePreset2Kelvin, StringFormat={}{0} K}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Lux" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding TunableWhitePreset2Lux, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TunableWhitePreset2Lux, StringFormat={}{0} lux}" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Row="3" Grid.Column="3" Margin="0,0,0,8">
                                    <Border Height="18" Background="{Binding TunableWhitePreset2Brush}" CornerRadius="3" Margin="0,0,0,4"/>
                                    <Border Height="18" Background="{Binding TunableWhitePreset2LuxBrush}" CornerRadius="3"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Preset 3" VerticalAlignment="Top" Margin="0,2,8,8"/>
                                <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Kelvin" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="1800" Maximum="6500" TickFrequency="100" IsSnapToTickEnabled="True"
                                            Value="{Binding TunableWhitePreset3Kelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TunableWhitePreset3Kelvin, StringFormat={}{0} K}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Lux" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding TunableWhitePreset3Lux, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TunableWhitePreset3Lux, StringFormat={}{0} lux}" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Row="4" Grid.Column="3" Margin="0,0,0,8">
                                    <Border Height="18" Background="{Binding TunableWhitePreset3Brush}" CornerRadius="3" Margin="0,0,0,4"/>
                                    <Border Height="18" Background="{Binding TunableWhitePreset3LuxBrush}" CornerRadius="3"/>
                                </StackPanel>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Preset 4" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Kelvin" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="1800" Maximum="6500" TickFrequency="100" IsSnapToTickEnabled="True"
                                            Value="{Binding TunableWhitePreset4Kelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TunableWhitePreset4Kelvin, StringFormat={}{0} K}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Lux" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding TunableWhitePreset4Lux, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TunableWhitePreset4Lux, StringFormat={}{0} lux}" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Row="5" Grid.Column="3">
                                    <Border Height="18" Background="{Binding TunableWhitePreset4Brush}" CornerRadius="3" Margin="0,0,0,4"/>
                                    <Border Height="18" Background="{Binding TunableWhitePreset4LuxBrush}" CornerRadius="3"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Default Kelvin">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                          Content="Apply Tunable White Default Kelvin (full write)"
                                          IsChecked="{Binding ApplyTunableWhiteDefaultKelvin, Mode=TwoWay}"
                                          Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Width="56" HorizontalAlignment="Left"
                                         Text="{Binding TunableWhiteDefaultKelvinVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Kelvin" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="1800" Maximum="6500"
                                        Value="{Binding TunableWhiteDefaultKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,12,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical">
                                    <TextBlock Text="{Binding TunableWhiteDefaultKelvin, StringFormat={}{0} K}" VerticalAlignment="Center"/>
                                    <Border Height="20" Margin="0,6,0,0" Background="{Binding TunableWhiteDefaultKelvinBrush}" CornerRadius="3"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar Width="120"
                             Height="10"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}"
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}"
                        Content="Load profile"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Command="{Binding LoadProfileCommand}"/>
                <Button Style="{StaticResource GhostButton}"
                        Content="Save profile"
                        Padding="16,8"
                        Margin="0,0,16,0"
                        Command="{Binding SaveProfileCommand}"/>

                <Button Style="{StaticResource GhostButton}"
                        Content="Read current"
                        Padding="18,8"
                        Margin="0,0,8,0"
                        Command="{Binding ReadCurrentCommand}"/>
                <Button Style="{StaticResource GhostButton}"
                        Content="Apply now"
                        Padding="18,8"
                        Margin="0,0,8,0"
                        Command="{Binding ApplyNowCommand}"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Queue update with profile"
                        Padding="18,8"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding CanQueueUpdateWithProfile}"
                        Command="{Binding QueueUpdateWithProfileCommand}"/>
                <Button Style="{StaticResource GhostButton}"
                        Content="Close"
                        Padding="18,8"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
