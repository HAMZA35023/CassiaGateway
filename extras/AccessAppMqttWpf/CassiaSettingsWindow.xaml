<Window x:Class="AccessAppMqttWpf.CassiaSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AccessAppMqttWpf.Models"
        Title="Cassia Web Settings"
        Height="840"
        Width="1220"
        MinHeight="760"
        MinWidth="980"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="FieldReadOnlyTemplate">
            <TextBlock Text="{Binding ValueText}" VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldTextTemplate">
            <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldPasswordTemplate">
            <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldTextAreaTemplate">
            <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="70"
                     TextWrapping="Wrap"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldSelectTemplate">
            <ComboBox ItemsSource="{Binding SelectOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="False"/>
        </DataTemplate>

        <DataTemplate x:Key="FieldCheckboxTemplate">
            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Mirrors Cassia HTML navigation and JSON binding. Save sends only changed keys."
                           Margin="0,4,0,8"
                           Foreground="{DynamicResource MutedBrush}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Gateway IP" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding GatewayIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="3" Text="Username" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="6" Text="Password" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="7" Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="9" Text="Encrypted pass" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="10"
                             Text="{Binding PasswordEncrypted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Optional encrypted password used for /cassia/login"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0"
                            ItemsSource="{Binding NavigationTabs}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:CassiaSettingsTab}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type models:CassiaSettingsTab}">
                            <TabControl Margin="6,6,6,0"
                                        ItemsSource="{Binding Sections}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CassiaSettingsSection}">
                                        <TextBlock Text="{Binding Title}"/>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>

                                <TabControl.ContentTemplate>
                                    <DataTemplate DataType="{x:Type models:CassiaSettingsSection}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:CassiaEditableSettingItem}">
                                                        <Border BorderBrush="#14000000" BorderThickness="0,0,0,1" Padding="0,8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="280"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="0"
                                                                           Text="{Binding Label}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,2,12,2"/>

                                                                <ContentControl Grid.Row="0"
                                                                                Grid.Column="1"
                                                                                Content="{Binding}"
                                                                                IsEnabled="{Binding IsEnabled}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl">
                                                                            <Setter Property="ContentTemplate" Value="{StaticResource FieldTextTemplate}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPasswordEditor}" Value="True">
                                                                                    <Setter Property="ContentTemplate" Value="{StaticResource FieldPasswordTemplate}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsTextAreaEditor}" Value="True">
                                                                                    <Setter Property="ContentTemplate" Value="{StaticResource FieldTextAreaTemplate}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsSelectEditor}" Value="True">
                                                                                    <Setter Property="ContentTemplate" Value="{StaticResource FieldSelectTemplate}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsCheckBoxEditor}" Value="True">
                                                                                    <Setter Property="ContentTemplate" Value="{StaticResource FieldCheckboxTemplate}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                                                    <Setter Property="ContentTemplate" Value="{StaticResource FieldReadOnlyTemplate}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                </ContentControl>

                                                                <Border Grid.Row="0"
                                                                        Grid.Column="2"
                                                                        Margin="12,0,0,0"
                                                                        Padding="8,2"
                                                                        BorderBrush="#22007ACC"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Background="#10007ACC">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="Changed" Foreground="#007ACC"/>
                                                                </Border>

                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="1"
                                                                           Margin="0,4,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           Text="{Binding Path}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Path}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <Expander Grid.Row="1" Header="Debug JSON (read-only)" Margin="4,10,4,0">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding RawSettingsJson}"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>

                        <TextBox Grid.Column="2"
                                 Text="{Binding RawSavePayloadPreviewJson}"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </Expander>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding StatusText}"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="Load" Padding="18,8" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Save" Padding="18,8" Margin="0,0,8,0"
                        Command="{Binding SaveCommand}"/>
                <Button Style="{StaticResource GhostButton}" Content="Close" Padding="18,8"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
